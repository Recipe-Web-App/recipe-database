{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':enablePreCommit',
    ':semanticCommits',
    ':dependencyDashboard',
  ],
  timezone: 'America/New_York',
  schedule: [
    'before 10am on monday',
  ],
  assignees: [
    'jsamuelsen11',
  ],
  prConcurrentLimit: 100,
  prHourlyLimit: 0,
  rebaseWhen: 'behind-base-branch',
  dependencyDashboard: true,
  dependencyDashboardTitle: 'Dependency Dashboard',
  dependencyDashboardLabels: [
    'dependencies',
    'renovate',
  ],
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
    schedule: [
      'at any time',
    ],
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 9am on the first day of the month',
    ],
  },
  packageRules: [
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github-actions',
      labels: [
        'dependencies',
        'github-actions',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'actions',
    },
    {
      matchManagers: [
        'kubernetes',
        'dockerfile',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
      matchPackageNames: [
        '/^postgres$/',
        '/postgres-exporter/',
      ],
    },
    {
      matchManagers: [
        'kubernetes',
        'dockerfile',
      ],
      labels: [
        'dependencies',
        'docker',
      ],
      semanticCommitType: 'docker',
      semanticCommitScope: 'k8s',
    },
    {
      matchManagers: [
        'pip_requirements',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
      matchPackageNames: [
        '/^psycopg2/',
        '/^pandas$/',
        '/^numpy$/',
      ],
    },
    {
      matchManagers: [
        'pip_requirements',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      groupName: 'python-patch-updates',
      labels: [
        'dependencies',
        'python',
      ],
      semanticCommitType: 'deps',
      semanticCommitScope: 'python',
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
    {
      matchManagers: [
        'pip_requirements',
      ],
      matchUpdateTypes: [
        'minor',
      ],
      groupName: 'python-minor-updates',
      labels: [
        'dependencies',
        'python',
      ],
      semanticCommitType: 'deps',
      semanticCommitScope: 'python',
    },
    {
      matchManagers: [
        'pre-commit',
      ],
      labels: [
        'dependencies',
        'pre-commit',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'pre-commit',
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'dependencies',
        'breaking-change',
      ],
      prBodyNotes: [
        ':warning: **Major version update** - This PR requires manual review before merging.',
      ],
    },
  ],
  kubernetes: {
    managerFilePatterns: [
      '/k8s/.*\\.ya?ml$/',
      '/k8s/jobs/.*\\.ya?ml$/',
    ],
  },
}
